# explainer-video scratch — disposable, regenerable, never commit
out/
.explainer-video/
frames/
preview/
parts/

# the deliverable videos are large binaries — dump them somewhere you own, not into a code repo
*.mp4

.DS_Store

# a stray .env must never be committed — the key now lives in the OS secret store
.env

# bytecode: regenerated on every import, so it has no business in a repo
__pycache__/
*.pyc
