{
  "name": "explainer-video",
  "version": "0.4.0",
  "description": "Turn structured coursework notes, or a codebase's major code flows, into a narrated, animated explainer-video series.",
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": ">=22"
  },
  "author": {
    "name": "Akshay Prabhakant"
  },
  "license": "MIT",
  "scripts": {
    "sync:coursework-author": "node scripts/sync-coursework-author.mjs",
    "check:coursework-author-sync": "node scripts/check-coursework-author-sync.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "sync:tree-sitter": "node scripts/sync-tree-sitter.mjs",
    "check:tree-sitter-vendor": "node scripts/check-tree-sitter-vendor.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akshayDev17/ai-explainer-video.git"
  },
  "keywords": [
    "explainer-video",
    "coursework",
    "codebase",
    "code-flow",
    "narration",
    "animation",
    "text-to-speech",
    "video"
  ],
  "files": [
    "plugin.json",
    ".claude-plugin/plugin.json",
    "skills/",
    "!skills/*/fixtures/",
    "lib/",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "coursework-author": "^1.0.2",
    "tree-sitter-c": "0.24.1",
    "tree-sitter-cpp": "0.23.4",
    "tree-sitter-go": "0.25.0",
    "tree-sitter-javascript": "0.25.0",
    "tree-sitter-python": "0.25.0",
    "tree-sitter-typescript": "0.23.2",
    "web-tree-sitter": "0.27.1"
  }
}
