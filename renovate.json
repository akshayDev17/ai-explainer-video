{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "matchPackageNames": ["coursework-author"],
      "groupName": "coursework-author",
      "automerge": false,
      "labels": ["dependencies", "vendored-skill"]
    },
    {
      "matchPackageNames": ["web-tree-sitter", "tree-sitter-python", "tree-sitter-typescript", "tree-sitter-javascript", "tree-sitter-go", "tree-sitter-c", "tree-sitter-cpp"],
      "groupName": "tree-sitter",
      "rangeStrategy": "pin",
      "automerge": false,
      "labels": ["dependencies", "vendored-grammars"]
    }
  ]
}
